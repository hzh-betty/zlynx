@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(zco 1 CONFIG)
find_dependency(znet 1 CONFIG)
find_dependency(zlog 1 CONFIG)
find_dependency(fmt CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(toml11 CONFIG)
find_dependency(OpenSSL 1.1 COMPONENTS Crypto)
find_dependency(ZLIB)
find_dependency(Threads)
find_dependency(PkgConfig)
pkg_check_modules(Brotli QUIET IMPORTED_TARGET libbrotlienc)
if(NOT Brotli_FOUND)
    set(zhttp_FOUND FALSE)
    set(zhttp_NOT_FOUND_MESSAGE "Brotli encoder (libbrotlienc.pc) was not found")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/zhttpTargets.cmake")
check_required_components(zhttp)
